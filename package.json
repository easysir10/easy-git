{
  "name": "@easysir10/easy-git",
  "version": "0.6.0",
  "description": "新手友好的 git 助手：DSH 插件 + 通用 Skill + 零依赖 CLI，兼容 GitLab/GitHub/Gitee 等一切 git 工具。",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "easy-git": "./bin/easy-git.mjs"
  },
  "scripts": {
    "prepare": "node scripts/install-hint.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./core": "./src/core.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "src",
    "scripts",
    "skills",
    "codex",
    "command"
  ],
  "keywords": [
    "dsh",
    "plugin",
    "git",
    "gitlab",
    "github",
    "beginner",
    "cli"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8"
  }
}
